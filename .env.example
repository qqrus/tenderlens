APP_NAME=TenderLens API
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501"]

POSTGRES_DB=tenderlens
POSTGRES_USER=tenderlens
POSTGRES_PASSWORD=tenderlens
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tenderlens:tenderlens@postgres:5432/tenderlens

UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=300
CHUNK_SIZE_CHARS=1600
CHUNK_OVERLAP_CHARS=200

EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_CACHE_DIR=data/models
RETRIEVAL_DENSE_K=20
RETRIEVAL_LEXICAL_K=20
RETRIEVAL_FINAL_K=5
RRF_K=60

# Zero-cost default. Use ollama for local generation or openai for an API model.
# API keys must only be placed in .env and never committed.
LLM_PROVIDER=extractive
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
LLM_TIMEOUT_SECONDS=90
QA_EVIDENCE_LIMIT=5
QA_MAX_CLAIMS=5
ANALYSIS_RETRIEVAL_LIMIT=8
ANALYSIS_MAX_ITEMS_PER_CATEGORY=5
