APP_NAME=TenderLens API
APP_ENV=development
LOG_LEVEL=INFO
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:8501"]

POSTGRES_DB=tenderlens
POSTGRES_USER=tenderlens
POSTGRES_PASSWORD=tenderlens
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://tenderlens:tenderlens@postgres:5432/tenderlens

UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=20
MAX_PDF_PAGES=300
CHUNK_SIZE_CHARS=1600
CHUNK_OVERLAP_CHARS=200

# Local-first model configuration. API keys must only be placed in .env.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:4b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
